<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بی نهایت دوستت دارم ❤️</title>
    <style>
        body {
            font-family: Tahoma, sans-serif;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4);
            margin: 0;
            padding: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        h1 {
            color: #d63031;
            font-size: 22px;
        }
        p {
            color: #636e72;
            font-size: 14px;
        }
        button {
            background-color: #e84393;
            color: white;
            border: none;
            padding: 10px 18px;
            font-size: 14px;
            border-radius: 8px;
            cursor: pointer;
            margin: 5px;
            transition: 0.3s;
        }
        button:hover {
            background-color: #d63031;
        }
        #counter {
            font-size: 16px;
            font-weight: bold;
            margin: 15px 0;
            color: #2d3436;
        }
        #log {
            background: #f1f2f6;
            border-radius: 8px;
            padding: 10px;
            height: 250px;
            overflow-y: auto;
            text-align: right;
            font-size: 13px;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>تقدیم به عشقم ❤️</h1>
        <p>تا ابد دوستت دارم...</p>
        
        <div id="controls">
            <button onclick="startTyping()">شروع عشق‌بازی ❤️</button>
            <button onclick="stopTyping()">توقف</button>
        </div>

        <div id="counter">تعداد چاپ شده: 0</div>
        <div id="log"></div>
    </div>

    <script>
        let isRunning = false;
        let count = 0;
        const target = 10000000000000;
        let batchSize = 100;

        function startTyping() {
            if (isRunning) return;
            isRunning = true;
            typeBatch();
        }

        function typeBatch() {
            if (!isRunning) return;
            
            let logDiv = document.getElementById('log');
            let counterDiv = document.getElementById('counter');
            let fragment = document.createDocumentFragment();

            for (let i = 0; i < batchSize; i++) {
                if (count >= target) {
                    isRunning = false;
                    break;
                }
                count++;
                let p = document.createElement('div');
                p.textContent = `${count.toLocaleString('fa-IR')}- دوستت دارم ❤️`;
                fragment.appendChild(p);
            }

            logDiv.appendChild(fragment);
            counterDiv.textContent = `تعداد چاپ شده: ${count.toLocaleString('fa-IR')}`;
            logDiv.scrollTop = logDiv.scrollHeight;

            if (isRunning && count < target) {
                requestAnimationFrame(typeBatch);
            }
        }

        function stopTyping() {
            isRunning = false;
        }
    </script>

</body>
</html>
